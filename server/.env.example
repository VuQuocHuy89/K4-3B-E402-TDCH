PORT=4173
# Render injects this value from the managed PostgreSQL service.
DATABASE_URL=
DB_SSL=true
# Local default: Groq. Optional providers are tried on failure; never substitute mock lessons or tests.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
# Compound Mini có web search tích hợp cho bước tìm nguồn.
GROQ_SOURCE_MODEL=groq/compound-mini
GROQ_MAX_TOKENS=5000
GROQ_SOURCE_MAX_TOKENS=3000
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# Đường dẫn PDF local; không commit PDF hoặc file .env lên GitHub.
DOCUMENT_PDF_PATH=/home/vuquochuy/AI-VinUni/Mini-hackathon/Grokking Machine Learning.pdf
# Production có thể dùng URL HTTPS tới nơi lưu trữ được cấp quyền; file sẽ được cache vào /tmp.
DOCUMENT_PDF_URL=
DOCUMENT_PDF_CACHE_PATH=/tmp/pathwise-document.pdf
DOCUMENT_PDF_TIMEOUT_MS=20000
# Bump this when the published content-pack seed changes.
CONTENT_CATALOG_VERSION=seed-v1

# Provider dự phòng (tuỳ chọn nhưng nên điền để demo không phụ thuộc một quota).
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=800
OPENROUTER_API_KEY=
# Web grounding được gọi khi cần tìm học liệu mới; nguồn trả về vẫn bị lọc theo allowlist.
SOURCE_DISCOVERY_MAX_RESULTS=5
# OPENROUTER_HTTP_REFERER=http://localhost:4173
# OPENROUTER_TITLE=Pathwise AI Engineer Learning Path

# Timeout từng lần gọi provider; các bước học dùng ngân sách riêng. Trace không lưu API key.
AI_TIMEOUT_MS=12000
LEARNING_AI_TIMEOUT_MS=60000
LEARNING_SOURCE_TIMEOUT_MS=30000
SOURCE_DISCOVERY_TIMEOUT_MS=8000
AI_TRACE_FILE=/tmp/pathwise-agent-trace.jsonl
